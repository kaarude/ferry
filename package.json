{
  "name": "ferry",
  "version": "0.1.0",
  "private": true,
  "description": "Discord forum bot that turns bug reports and feature requests into GitHub issues.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24",
    "bun": ">=1.3"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "dev:bun": "bun --watch src/index.ts",
    "start:bun": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "test:bun": "bun --bun vitest run --dir src",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.14.0",
    "discord.js": "14.28.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/node": "24.10.1",
    "typescript": "7.0.2",
    "vitest": "5.1.2"
  }
}
