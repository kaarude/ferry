# Discord bot token (Discord Developer Portal > your app > Bot > Reset Token).
DISCORD_TOKEN=your-discord-bot-token

# Fine-grained GitHub token with "Issues: Read and write" on the repos you link.
GITHUB_TOKEN=github_pat_your-token

# Optional. Enables the AI duplicate check. Leave empty to turn it off.
ANTHROPIC_API_KEY=

# Optional. Claude model used for the duplicate check.
AI_MODEL=claude-opus-5-5

# Optional. Where the SQLite database lives.
DATABASE_PATH=./data/ferry.db

# Optional. How often Ferry checks GitHub for closed or reopened issues.
POLL_INTERVAL_MINUTES=5
